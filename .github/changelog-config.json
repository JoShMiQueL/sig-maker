{
  "categories": [
    {
      "title": "🚀 Features",
      "labels": ["feature", "feat", "enhancement"]
    },
    {
      "title": "⚡ Performance",
      "labels": ["performance", "perf", "speed"]
    },
    {
      "title": "🐛 Bug Fixes",
      "labels": ["fix", "bug", "bugfix"]
    },
    {
      "title": "🔧 Refactoring",
      "labels": ["refactor", "cleanup", "clean"]
    },
    {
      "title": "🧪 Tests",
      "labels": ["test", "tests", "testing"]
    },
    {
      "title": "📚 Documentation",
      "labels": ["docs", "documentation", "doc"]
    },
    {
      "title": "🔁 CI/CD",
      "labels": ["ci", "cd", "github-actions", "workflow"]
    },
    {
      "title": "⬆️ Dependencies",
      "labels": ["dependencies", "deps", "bump", "update"]
    }
  ],
  "ignore_labels": [
    "ignore",
    "changelog-ignore"
  ],
  "sort": {
    "order": "ASC",
    "on_property": "mergedAt"
  },
  "template": "#{{CHANGELOG}}\n\n---\n\n## 📊 Stats\n\n- **Commits**: #{{COMMITS}}\n- **Pull Requests**: #{{MERGES}}\n- **Contributors**: #{{CONTRIBUTORS}}\n\n**Full Changelog**: #{{RELEASE_DIFF}}",
  "pr_template": "- #{{TITLE}} by @#{{AUTHOR}} in ##{{NUMBER}}",
  "empty_template": "- No changes",
  "label_extractor": [
    {
      "pattern": "^(feat|feature|add|implement).*",
      "on_property": "title",
      "method": "match",
      "target": "feature"
    },
    {
      "pattern": "^(fix|bug|repair|patch).*",
      "on_property": "title",
      "method": "match",
      "target": "fix"
    },
    {
      "pattern": "^(perf|optim|speed|fast).*",
      "on_property": "title",
      "method": "match",
      "target": "performance"
    },
    {
      "pattern": "^(refactor|clean|move|rename).*",
      "on_property": "title",
      "method": "match",
      "target": "refactor"
    },
    {
      "pattern": "^(test|bench).*",
      "on_property": "title",
      "method": "match",
      "target": "test"
    },
    {
      "pattern": "^(doc|readme|comment).*",
      "on_property": "title",
      "method": "match",
      "target": "docs"
    },
    {
      "pattern": "^(ci|cd|workflow|action).*",
      "on_property": "title",
      "method": "match",
      "target": "ci"
    },
    {
      "pattern": "^(deps|dependency|bump|update).*",
      "on_property": "title",
      "method": "match",
      "target": "dependencies"
    }
  ],
  "duplicates": {
    "filter": "author",
    "exclude": {
      "labels": ["release", "automated"]
    }
  },
  "max_pull_requests": 1000,
  "max_back_track_time_days": 365
}
