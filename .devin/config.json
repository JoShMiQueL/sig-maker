{
  "permissions": {
	  "allow": [
      "Read(**)",
      "Exec(git)",
      "Exec(cargo)",
      "Exec(sh)"
    ],
    "deny": [
      "Exec(sudo)",
      "Write(.git/**)"
    ],
    "ask": [
      "Exec(git commit)",
      "Exec(git push)",
      "Exec(git reset --hard)",
      "Exec(git clean -fd)",
      "Exec(git branch -D)",
      "Exec(git push --force)",
      "Exec(git rebase)",
      "Exec(gh repo delete)",
      "Exec(gh release delete)",
	    "Exec(rm)"
    ]
  },
  "read_config_from": {
    "cursor": true,
    "windsurf": true,
    "claude": true
  },
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "transport": "http"
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "transport": "http"
    }
  }
}
