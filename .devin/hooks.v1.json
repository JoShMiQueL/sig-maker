{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "sh .githooks/setup.sh"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "exec",
      "hooks": [
        {
          "type": "command",
          "command": "sh .devin/scripts/check-git-commit.sh",
          "timeout": 5
        }
      ]
    }
  ]
}
