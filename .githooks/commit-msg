#!/bin/sh
#
# commit-msg hook: validates commit message follows Conventional Commits format.
# Format: <type>(<optional scope>): <description>
#
# Valid types: feat, fix, docs, style, refactor, perf, test, ci, chore, build, revert
# Examples:
#   feat: add new output format
#   fix(cli): handle empty input file
#   ci: update GitHub Actions versions
#   chore!: drop support for Rust 1.70

commit_msg_file="$1"
commit_msg=$(head -1 "$commit_msg_file")

# Allow merge commits and fixup/squash
if echo "$commit_msg" | grep -qE "^(Merge|Revert|fixup!|squash!)"; then
    exit 0
fi

# Validate conventional commit format
if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|perf|test|ci|chore|build|revert)(\(.+\))?\!?: .+"; then
    echo ""
    echo "ERROR: Commit message does not follow Conventional Commits format."
    echo ""
    echo "Expected: <type>(<scope>): <description>"
    echo ""
    echo "Types: feat, fix, docs, style, refactor, perf, test, ci, chore, build, revert"
    echo ""
    echo "Examples:"
    echo "  feat: add JSON output format"
    echo "  fix(cli): handle missing input file"
    echo "  docs: update README examples"
    echo "  ci: migrate to cargo-dist"
    echo "  chore!: bump MSRV to 1.85"
    echo ""
    echo "Your message: $commit_msg"
    exit 1
fi
