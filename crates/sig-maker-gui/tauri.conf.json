{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sig-maker-gui",
  "version": "0.1.2-beta",
  "identifier": "com.joshmiguel.sig-maker",
  "build": {
    "frontendDist": "frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sig-Maker",
        "width": 900,
        "height": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": []
  }
}
