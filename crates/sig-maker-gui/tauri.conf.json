{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sig-maker-gui",
  "version": "0.1.2-beta",
  "identifier": "com.joshmiguel.sig-maker",
  "build": {
    "devUrl": "http://localhost:4321",
    "frontendDist": "./frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sig-Maker",
        "width": 900,
        "height": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
